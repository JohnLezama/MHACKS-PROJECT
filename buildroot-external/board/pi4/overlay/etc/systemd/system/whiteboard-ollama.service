[Unit]
Description=WhiteBoardOS local metadata inference
Requires=whiteboard-prepare.service
After=whiteboard-prepare.service

[Service]
User=whiteboard
Group=whiteboard
Environment=HOME=/data/whiteboardos
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=/data/whiteboardos/models
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_CONTEXT_LENGTH=2048
ExecStart=/usr/bin/ollama serve
Restart=on-failure
RestartSec=5
Nice=10
MemoryHigh=1500M
MemoryMax=2G
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/data/whiteboardos

[Install]
WantedBy=multi-user.target
